# Red Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Contrato Trike desplegado
TRIKE_CONTRACT_ID=

# Cuenta oracle/admin del contrato (reporta depósitos entrantes)
ORACLE_SECRET_KEY=

# Clave compartida para autenticar llamadas internas al endpoint de depósitos
ORACLE_API_KEY=

# Login con Google (dashboard de clientes) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth: NEXTAUTH_URL es la URL pública del sitio (ej. https://trikes.vercel.app en
# producción, http://localhost:3000 en local). NEXTAUTH_SECRET es cualquier string
# aleatorio largo, generado una sola vez (ej. `openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
